generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductBadge {
  NEW
  BEST_SELLER
  LIMITED
  SOLD_OUT
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  SUPPORT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  AWAITING_VERIFICATION
  PAID
  REFUNDED
  FAILED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum MessageStatus {
  NEW
  READ
  ARCHIVED
}

enum PaymentMethod {
  COD
  CARD
  WALLET
  INSTAPAY
}

// ───────────────────────── Catalog ─────────────────────────

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  name      String
  slug      String    @unique
  products  Product[]
}

model Product {
  id                 String              @id @default(uuid()) @db.Uuid
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId         String              @db.Uuid
  name               String
  slug               String              @unique
  description        String
  material           String?
  careInstructions   String?
  price              Decimal             @db.Decimal(10, 2)
  /// Price for 3XL, 4XL and 5XL. Null = same as `price`.
  priceLarge         Decimal?            @db.Decimal(10, 2)
  compareAtPrice     Decimal?            @db.Decimal(10, 2)
  costPrice          Decimal?            @db.Decimal(10, 2)
  currency           String              @default("EGP")
  status             ProductStatus       @default(DRAFT)
  badge              ProductBadge?
  featured           Boolean             @default(false)
  publishedAt        DateTime?
  metaTitle          String?
  metaDescription    String?
  viewCount          Int                 @default(0)
  variants           ProductVariant[]
  images             ProductImage[]
  orderItems         OrderItem[]

  @@index([status, deletedAt])
  @@index([categoryId])
  @@index([featured])
  @@index([createdAt])
}

model ProductVariant {
  id         String      @id @default(uuid()) @db.Uuid
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String      @db.Uuid
  sku        String      @unique
  colorName  String
  colorHex   String
  size       String
  stock      Int         @default(0)
  reserved   Int         @default(0)
  lowStockAt Int         @default(5)
  position   Int         @default(0)
  orderItems OrderItem[]

  @@unique([productId, colorName, size])
  @@index([productId])
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String   @db.Uuid
  url       String
  alt       String   @default("")
  sortOrder Int      @default(0)

  @@index([productId, sortOrder])
}

// ───────────────────────── Customers & Orders ─────────────────────────

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Optional: customers can order with just a phone number and address.
  email     String?  @unique
  name      String
  phone     String?
  notes     String?
  orders    Order[]
}

model Order {
  id              String        @id @default(uuid()) @db.Uuid
  number          Int           @unique @default(autoincrement())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId      String?       @db.Uuid
  email           String?
  customerName    String
  phone           String
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentMethod   PaymentMethod @default(COD)
  paymentSender   String?
  paymentReference String?
  /// Storage path (private bucket) of the customer's transfer screenshot
  paymentProof    String?
  paidAt          DateTime?
  subtotal        Decimal       @db.Decimal(10, 2)
  shippingFee     Decimal       @default(0) @db.Decimal(10, 2)
  discount        Decimal       @default(0) @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  currency        String        @default("EGP")
  shippingAddress Json
  couponCode      String?
  notes           String?
  internalNote    String?
  items           OrderItem[]

  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([customerId])
  @@index([email])
}

model OrderItem {
  id        String          @id @default(uuid()) @db.Uuid
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String          @db.Uuid
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId String?         @db.Uuid
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantId String?         @db.Uuid
  name      String
  sku       String
  color     String
  size      String
  image     String?
  unitPrice Decimal         @db.Decimal(10, 2)
  quantity  Int

  @@index([orderId])
  @@index([productId])
}

// ───────────────────────── Admin ─────────────────────────

/// `id` equals the Supabase Auth user id.
model AdminUser {
  id        String     @id @db.Uuid
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  email     String     @unique
  name      String
  role      AdminRole  @default(EDITOR)
  isActive  Boolean    @default(true)
  auditLogs AuditLog[]
}

model AuditLog {
  id         String     @id @default(uuid()) @db.Uuid
  createdAt  DateTime   @default(now())
  admin      AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminId    String?    @db.Uuid
  adminEmail String
  action     String
  entity     String
  entityId   String?
  summary    String
  metadata   Json?

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([adminId])
}

// ───────────────────────── Marketing & settings ─────────────────────────

model Coupon {
  id          String       @id @default(uuid()) @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  code        String       @unique
  description String?
  type        DiscountType @default(PERCENT)
  value       Decimal      @db.Decimal(10, 2)
  minSubtotal Decimal?     @db.Decimal(10, 2)
  maxUses     Int?
  usedCount   Int          @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean      @default(true)

  @@index([isActive])
}

/// Single-row table (id is always 1).
model StoreSettings {
  id                    Int      @id @default(1)
  updatedAt             DateTime @updatedAt
  storeName             String   @default("Tema Label")
  supportEmail          String?
  supportPhone          String?
  announcement          String?
  standardShippingFee   Decimal  @default(80) @db.Decimal(10, 2)
  expressShippingFee    Decimal  @default(150) @db.Decimal(10, 2)
  freeShippingThreshold Decimal  @default(1500) @db.Decimal(10, 2)

  codEnabled            Boolean  @default(true)
  instapayEnabled       Boolean  @default(false)
  instapayHandle        String?
  instapayAccountName   String?
  walletEnabled         Boolean  @default(false)
  walletProvider        String?
  walletNumber          String?
  paymentInstructions   String?

  storeHours            String?
  googleVerification    String?
  bingVerification      String?

  /// Transfer orders waiting for confirmation longer than this many hours appear in the daily reminder.
  unpaidHoldHours       Int      @default(48)

  commercialRegister    String?
  taxCardNumber         String?
  businessAddress       String?

  instagramUrl          String?
  facebookUrl           String?
  tiktokUrl             String?
  xUrl                  String?
  pinterestUrl          String?
}

// ───────────────────────── Audience ─────────────────────────

model Subscriber {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  email     String   @unique
  isActive  Boolean  @default(true)
  source    String   @default("newsletter")

  @@index([createdAt])
}

model ContactMessage {
  id        String        @id @default(uuid()) @db.Uuid
  createdAt DateTime      @default(now())
  name      String
  email     String?
  phone     String?
  message   String
  status    MessageStatus @default(NEW)

  @@index([status, createdAt])
}

// ───────────────────────── Editable content ─────────────────────────

/// Policy / info pages edited from the admin (body is Markdown).
model ContentPage {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  slug        String   @unique
  title       String
  description String   @default("")
  body        String

  @@index([slug])
}

model FaqItem {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  question  String
  answer    String
  position  Int      @default(0)
  isActive  Boolean  @default(true)

  @@index([position])
}
