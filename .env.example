# Supabase (Project Settings → API Keys / Data API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Postgres (Connect → Transaction pooler, port 6543) — used by the app at runtime
DATABASE_URL=
# Postgres (Connect → Session pooler, port 5432) — used by `prisma migrate`
DIRECT_URL=

# Public site URL (canonical links, sitemap, Open Graph, structured data)
NEXT_PUBLIC_SITE_URL=https://temalabel.com

# ── Order notifications (all optional; without them the site works but sends no emails/alerts) ──
# Email via Resend (https://resend.com): verify your domain, then create an API key.
RESEND_API_KEY=
EMAIL_FROM="Tema Label <orders@temalabel.com>"
# Where new-order alerts go (defaults to the support email in Admin -> Settings)
ORDER_NOTIFY_EMAIL=
# Instant phone alerts: create a bot with @BotFather, send it a message, then use the chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Security ──
# Secret for the daily reminder job (any long random string)
CRON_SECRET=
# Signs order/unsubscribe links (defaults to SUPABASE_SECRET_KEY if empty)
ORDER_TOKEN_SECRET=
